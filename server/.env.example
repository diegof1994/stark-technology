# ==========================================
#  Stark Technology - Configuracion del servidor
#  Copia este archivo como `.env` y ajusta los valores.
# ==========================================

# Puerto del servidor (Render usa 10000 por defecto)
PORT=4000

# Entorno: development | production
NODE_ENV=development

# Origenes permitidos por CORS (separados por coma)
CLIENT_URL=http://localhost:5173

# Token de administracion para el ABM de inventario
# En produccion Render lo genera con `generateValue: true`
ADMIN_TOKEN=stark-dev-admin

# Mercado Pago - credenciales de prueba (sandbox)
# Dejalo vacio para trabajar en MODO SIMULACION (sin llamadas a la API real)
MERCADO_PAGO_SECRET_KEY=
MERCADO_PAGO_PUBLIC_KEY=

# URL publica donde vive la app (para redirecciones de checkout)
PUBLIC_URL=http://localhost:5173
