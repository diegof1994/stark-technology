{
  "name": "stark-technology",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stark Technology - E-commerce de informatica y seguridad electronica",
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "dev:client": "npm run dev --prefix client",
