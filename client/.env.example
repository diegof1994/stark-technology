# ==========================================
#  Stark Technology - Variables del frontend
#  Copia este archivo como `.env`
# ==========================================

# URL base de la API REST
# - En desarrollo se usa el proxy de Vite (/api -> http://localhost:4000)
# - En produccion apunta al servicio web de Render
VITE_API_URL=http://localhost:4000

# Token de administrador para el ABM del panel de inventario
VITE_ADMIN_TOKEN=stark-dev-admin

# Llave publica de Mercado Pago (opcional, para checkout real)
VITE_MERCADO_PAGO_PUBLIC_KEY=
